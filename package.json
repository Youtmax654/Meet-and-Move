  "scripts": {
    "start:mobile": "cd mobile && npm run start",
    "start:api": "cd api && npm run dev",
    "db:start": "cd db && docker compose up",
    "db:stop": "cd db && docker compose down",
    "db:prune": "cd db && docker compose down -v",
    "start": "mprocs",
    "install": "concurrently \"cd mobile && npm install --color=always\" \"cd api && npm install --color=always\" --names \"mobile\",\"api\" -c auto"
  },
