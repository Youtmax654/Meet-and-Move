  "scripts": {
    "start:mobile": "cd mobile && npm run start",
    "start:api": "cd api && npm run dev",
    "db:start": "cd db && docker compose up",
    "db:stop": "cd db && docker compose down",
    "db:reset": "cd db && docker compose down -v && docker compose up",
    "start": "mprocs",
    "install": "concurrently \"cd mobile && npm install\" \"cd api && npm install\" --names \"mobile\",\"api\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mprocs": "^0.9.2"
  }
}